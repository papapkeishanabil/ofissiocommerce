# Ofissio — Environment Variables Example
# Copy this file to `.env.local` and fill in real values.
# NEVER commit `.env.local`. Secrets MUST stay server-side (no NEXT_PUBLIC_ for secrets).

# --- Phase 1 (Commerce Foundation) ---
# Currently no env required. Reserved for future phases:

# --- Phase 8: WooCommerce Headless Product Source (server-only) ---
PRODUCT_SOURCE=mock
WOOCOMMERCE_ENABLED=false
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_SYNC_ORDERS=false

# Legacy aliases accepted by the foundation, kept only for migration notes.
# WOO_API_URL=https://your-wp.local/wp-json/wc/v3
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=

# --- Phase 5: iPaymu Payment Foundation (server-only) ---
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_BASE_URL=
IPAYMU_CALLBACK_URL=
IPAYMU_RETURN_URL=
IPAYMU_CANCEL_URL=

# Mock is the safe default until the official merchant contract is wired.
PAYMENT_PROVIDER=mock

# --- Phase 5: Shipping Foundation (server-only) ---
SHIPPING_PROVIDER=mock
DEFAULT_ORIGIN_CITY=Bandung
DEFAULT_ORIGIN_POSTAL_CODE=

# --- Phase 7: Ofistant AI (server-only) ---
# OFISTANT_LLM_API_KEY=
# OFISTANT_LLM_MODEL=

# --- Quotation email notification (server-only) ---
# Default mock means quotation is recorded but no real email is sent.
EMAIL_PROVIDER=mock
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# EMAIL_FROM="Ofissio <quotation@your-domain.com>"
# SALES_QUOTATION_EMAIL=sales@your-domain.com

# --- Phase 4: Meshy.ai AI 3D generation (server-only) ---
# Daftar di https://meshy.ai, ambil API key dari dashboard.
# Tanpa key ini, integrasi 3D akan pakai mock (depth-based fallback).
# MESHY_API_KEY=
