# Ofissio — Environment Variables Example
# Copy this file to `.env.local` for development or configure the same keys in
# staging/production hosting secrets. Never commit real secrets.
# Secrets MUST stay server-side. Do not create NEXT_PUBLIC_* variants for API keys.

# App
APP_URL=http://localhost:8000
NODE_ENV=development
LOG_LEVEL=info

# Product source
PRODUCT_SOURCE=mock

# Database / Supabase
DATABASE_PROVIDER=mock
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Auth
AUTH_PROVIDER=mock
AUTH_SESSION_COOKIE_NAME=ofissio_session

# Storage
STORAGE_PROVIDER=mock
STORAGE_BUCKET_LOGOS=ofissio-logos
STORAGE_BUCKET_ARTWORK=ofissio-artwork
STORAGE_BUCKET_DOCUMENTS=ofissio-documents
STORAGE_BUCKET_3D=ofissio-3d-models
STORAGE_SIGNED_URL_EXPIRES_SECONDS=3600
DOCUMENT_SIGNED_URL_EXPIRES_SECONDS=3600
DEFAULT_QUOTATION_TEMPLATE=quotation_default
DEFAULT_INVOICE_TEMPLATE=invoice_ofissio_custom
OFISSIO_INVOICE_LOCATION="Kabupaten Bandung, Indonesia"
OFISSIO_INVOICE_SIGNER_NAME="Triyadi Yuwono"
OFISSIO_INVOICE_SIGNER_TITLE="Direktur"
OFISSIO_CONTACT_TEL=-
OFISSIO_CONTACT_WEB=www.ofissio.com
OFISSIO_CONTACT_EMAIL=halo@ofissio.com
MAX_LOGO_UPLOAD_MB=10
MAX_DOCUMENT_UPLOAD_MB=20
MAX_GLB_UPLOAD_MB=100
# Batas global provider aktif. Supabase Free maksimal 50 MB; naikkan hanya
# setelah Storage Settings/plan Supabase mendukung nilai yang lebih besar.
SUPABASE_STORAGE_MAX_FILE_MB=50
PRODUCT_IMAGE_MAX_MB=10

# WooCommerce
WOOCOMMERCE_ENABLED=false
WOOCOMMERCE_BASE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
WOOCOMMERCE_SYNC_ORDERS=false
WOOCOMMERCE_TEST_WRITE=false
WOOCOMMERCE_ALLOW_SELF_SIGNED_TLS=false

# WordPress Media Library (server-side only)
# Base URL defaults to WOOCOMMERCE_BASE_URL when left empty.
WORDPRESS_MEDIA_BASE_URL=
WORDPRESS_MEDIA_USERNAME=
WORDPRESS_MEDIA_APP_PASSWORD=
# Optional alternative to username + application password.
WORDPRESS_MEDIA_TOKEN=

# Legacy aliases accepted by the foundation, kept only for migration.
# WOO_API_URL=https://your-wp.local/wp-json/wc/v3
# WOO_CONSUMER_KEY=
# WOO_CONSUMER_SECRET=

# Payment
PAYMENT_PROVIDER=mock
IPAYMU_ENABLED=false
IPAYMU_MODE=sandbox
IPAYMU_VA=
IPAYMU_API_KEY=
IPAYMU_BASE_URL=https://sandbox.ipaymu.com
IPAYMU_CALLBACK_URL=
IPAYMU_RETURN_URL=
IPAYMU_CANCEL_URL=
IPAYMU_EXPIRE_MINUTES=1440

# Shipping
SHIPPING_PROVIDER=mock
DEFAULT_ORIGIN_CITY=Bandung
DEFAULT_ORIGIN_POSTAL_CODE=
SHIPPING_PROVIDER_API_KEY=

# Email
EMAIL_PROVIDER=resend
EMAIL_ENABLED=true
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=
SALES_QUOTATION_EMAIL=
ORDER_NOTIFICATION_EMAIL_ENABLED=true
ORDER_NOTIFICATION_EMAILS=
EMAIL_TEST_SEND=false
EMAIL_TEST_TO=

# Auth secret placeholder / future
AUTH_SECRET=
NEXTAUTH_SECRET=

# Ofistant AI placeholder / future
# OFISTANT_LLM_API_KEY=
# OFISTANT_LLM_MODEL=

# Phase 4: Meshy.ai AI 3D generation placeholder (server-only)
# Daftar di https://meshy.ai, ambil API key dari dashboard.
# Tanpa key ini, integrasi 3D akan pakai mock (depth-based fallback).
# MESHY_API_KEY=
