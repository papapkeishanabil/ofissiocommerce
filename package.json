{
  "name": "ofissio",
  "version": "0.1.0",
  "private": true,
  "description": "Ofissio — Conversational B2B commerce platform for corporate uniform procurement.",
  "scripts": {
    "dev": "next dev -p 8000 -H 0.0.0.0",
    "dev:lan": "next dev -p 8000 -H 0.0.0.0",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:env": "node --experimental-strip-types scripts/check-env.ts",
    "check:supabase": "tsx scripts/check-supabase-schema.ts",
    "check:woocommerce": "tsx scripts/check-woocommerce.ts",
    "check:woocommerce-stock": "tsx --require ./scripts/register-server-only.cjs scripts/check-woocommerce-stock.ts",
    "check:storage": "tsx scripts/check-storage.ts",
    "check:email": "tsx scripts/check-email.ts",
    "check:documents": "tsx scripts/check-documents.ts",
    "check:payment": "tsx --require ./scripts/register-server-only.cjs scripts/check-payment.ts",
    "check:shipping": "tsx --require ./scripts/register-server-only.cjs scripts/check-shipping.ts",
    "check:auth": "tsx --require ./scripts/register-server-only.cjs scripts/check-auth.ts",
    "check:rls": "tsx --require ./scripts/register-server-only.cjs scripts/check-rls.ts",
    "check:ginee": "tsx --require ./scripts/register-server-only.cjs scripts/check-ginee.ts",
    "test:quantity-pricing": "tsx scripts/test-quantity-pricing.ts",
    "test:embroidery-pricing": "tsx scripts/test-embroidery-pricing.ts",
    "test:admin-notifications": "tsx scripts/test-admin-notifications.ts",
    "test:commercial-flow": "tsx scripts/test-commercial-flow.ts",
    "test:woocommerce-order-sync": "tsx scripts/test-woocommerce-order-sync.ts",
    "test:company-isolation": "tsx scripts/test-company-isolation.ts",
    "verify:supabase-persistence": "tsx scripts/verify-supabase-persistence.ts",
    "check:all": "npm run check:env && npm run check:auth && npm run check:rls && npm run check:ginee && npm run check:woocommerce-stock && npm run check:email && npm run check:documents && npm run check:payment && npm run check:shipping && npm run test:quantity-pricing && npm run test:embroidery-pricing && npm run test:admin-notifications && npm run test:commercial-flow && npm run test:woocommerce-order-sync && npm run typecheck && npm run lint && npm run build"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.10.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "lucide-react": "^0.469.0",
    "next": "15.5.4",
    "nodemailer": "^9.0.3",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "^7.83.0",
    "three": "^0.185.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@types/three": "^0.185.1",
    "eslint": "^9.18.0",
    "eslint-config-next": "15.5.4",
    "postcss": "^8.5.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3"
  }
}
